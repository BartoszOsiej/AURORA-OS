Output assets/aurora-demo.gif
Set FontSize 16
Set Width 960
Set Height 420
Set Shell bash
Set MarginColor "#0d1117"
Set Theme { "name": "aurora", "black": "#0d1117", "red": "#f85149", "green": "#3fb950", "yellow": "#e3b341", "blue": "#58a6ff", "magenta": "#a371f7", "cyan": "#39c5cf", "white": "#e6edf3", "brightBlack": "#8b949e" }
Type "npm install -g aurora-os"
Enter
Sleep 1s
Type "added 42 packages in 2.1s"
Enter
Sleep 400ms
Type "aurora-os --version"
Enter
Sleep 400ms
Type "aurora-os v1.0.0 (browser OS)"
Enter
Sleep 600ms
Type "aurora-os start"
Enter
Sleep 1s
Type "   ✓ Kernel loaded · Window manager · 9 apps"
Enter
Sleep 500ms
Type "# Complete OS in the browser · Kernel · filesystem"
Enter
Sleep 800ms
