Output assets/aurora-demo.svg

Set FontSize 16
Set Width 960
Set Height 420
Set Shell bash
Set MarginColor "#0d1117"
Set Theme {
  "name": "aurora",
  "black": "#0d1117",
  "red": "#f85149",
  "green": "#3fb950",
  "yellow": "#e3b341",
  "blue": "#58a6ff",
  "magenta": "#a371f7",
  "cyan": "#39c5cf",
  "white": "#e6edf3",
  "brightBlack": "#8b949e"
}

Type "npm install -g aurora-os"
Enter
Sleep 1s

Type "aurora-os --version"
Enter
Sleep 500ms

Type "aurora-os --help"
Enter
Sleep 800ms

Type "aurora-os start --browser"
Enter
Sleep 1s

Type "# Complete OS in the browser"
Enter
Sleep 500ms

Type "# Kernel · window manager · filesystem · 8 apps"
Enter
Sleep 1s
